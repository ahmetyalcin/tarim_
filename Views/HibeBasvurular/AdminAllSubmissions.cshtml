@model List<TarimHibe.Models.AdminHibeBasvuruViewModel>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewBag.Title = "Tüm Hibe Başvuruları";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // build durum SelectList just once
    var durumlar = new[] {
        new { Value="all",               Text="Tümü" },
        new { Value="Dekont Bekleniyor", Text="Dekont Bekleniyor" },
        new { Value="Onaylandı",         Text="Onaylandı" },
        new { Value="Reddedildi",        Text="Reddedildi" }
    };
    var slDurum = new SelectList(durumlar, "Value", "Text", ViewBag.SelectedDurum);
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-md-8">
                        <form asp-action="AdminAllSubmissions" method="get" class="row g-2 align-items-center">
                            <div class="col-auto">
                                @Html.DropDownList(
                                         "hibeId",
                                         (SelectList)ViewBag.HibeList,
                                         "-- Hibe Seçiniz --",
                                         new { @class = "form-select" })
                            </div>
                            <div class="col-auto">
                                @Html.DropDownList(
                                         "durum",
                                         slDurum,
                                         new { @class = "form-select" })
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary">Filtrele</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Başvuran</th>
                                <th>Hibe</th>
                                <th>Ücretli</th>
                                <th>Arazi</th>
                                <th>Başvuru T.</th>
                                <th>Dekont</th>
                                <th>Admin Onay</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                <tr>
                                    <td>@b.BasvuruID</td>
                                    <td>@b.BasvuranAdi</td>
                                    <td>@b.HibeTuru</td>
                                    <td>
                                        <span class="badge @(b.UcretliMi ? "bg-danger" : "bg-success")">
                                            @(b.UcretliMi ? "Ücretli" : "Ücretsiz")
                                        </span>
                                    </td>
                                    <td>@b.AraziBilgi</td>
                                    <td>@b.BasvuruTarihi.ToString("g")</td>
                                    <td>
                                        @if (b.UcretliMi)
                                        {
                                            if (!string.IsNullOrEmpty(b.DekontYolu))
                                            {
                                                <a href="~/uploads/dekont/@b.DekontYolu"
                                                   target="_blank"
                                                   class="link-primary">
                                                    Görüntüle
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-warning">Bekleniyor</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @* Admin Onay hücresi: önce reddedildi mi kontrol et *@
                                        @if (b.BasvuruDurumu == "Reddedildi")
                                        {
                                            <span class="badge bg-danger">Reddedildi</span>
                                        }
                                        else if (b.AdminOnay)
                                        {
                                            <span class="badge bg-success">Onaylandı</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Bekliyor</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="Approve" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@b.BasvuruID" />
                                            <button class="btn btn-sm btn-success"
                                            @(b.AdminOnay || b.BasvuruDurumu == "Reddedildi" ? "disabled" : "")>
                                                Onayla
                                            </button>
                                        </form>
                                        <form asp-action="Reject" method="post" class="d-inline ms-1">
                                            <input type="hidden" name="id" value="@b.BasvuruID" />
                                            <button class="btn btn-sm btn-danger"
                                            @(b.BasvuruDurumu == "Reddedildi" ? "disabled" : "")>
                                                Reddet
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>

                </div></div></div></div>


