@model List<TarimHibe.Models.Notification>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h2>Bildirimlerim</h2>
                <table class="table">
                    <thead>
                        <tr><th></th><th>Tarih</th><th>Başlık</th><th>Mesaj</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var n in Model)
                        {
                            <tr class="@(n.IsRead? "" : "table-warning")">
                                <td>
                                    @if (!n.IsRead)
                                    {
                                        <form asp-action="MarkRead" method="post">
                                            <input type="hidden" name="id" value="@n.NotificationId" />
                                            <button class="btn btn-sm btn-link">Okundu</button>
                                        </form>
                                    }
                                </td>
                                <td>@n.CreatedAt:g</td>
                                <td>@n.Title</td>
                                <td>@n.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>

                </div>
                </div>
                </div>
                </div>
                

