@model List<TarimHibe.Models.Ekipmanlar>
@{
    ViewBag.Title = "Ekipmanlarım";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="card-title mb-0">Ekipmanlarım</h4>
                        <p class="card-title-desc">Kayıtlı ekipmanlarınızın listesi</p>
                    </div>
                    <a href="@Url.Action("Add", "Ekipmanlar")" class="btn btn-primary">
                        <i class="ri-add-line align-middle me-1"></i> Yeni Ekipman Ekle
                    </a>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Ekipman Adı</th>
                                <th>Tür</th>
                                <th>Plaka</th>
                                <th>Marka</th>
                                <th>Model</th>
                                <th>Adet</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.EkipmanID</td>
                                        <td>@item.EkipmanAdi</td>
                                        <td>@item.EkipmanTurleri.TurAdi</td>
                                        <td>@item.Plaka</td>
                                        <td>@item.Marka</td>
                                        <td>@item.Modeli</td>
                                        <td>@item.Adet</td>
                                        <td>
                                            <span class="badge @(item.Durum == "Aktif" ? "bg-success" : "bg-danger")">
                                                @item.Durum
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a href="@Url.Action("Edit", "Ekipmanlar", new { id = item.EkipmanID })"
                                                   class="btn btn-primary btn-sm" title="Düzenle">
                                                    <i class="ri-pencil-line"></i>
                                                </a>
                                                <button type="button" class="btn btn-danger btn-sm delete-ekipman"
                                                        data-id="@item.EkipmanID" title="Sil">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center">Henüz kayıtlı ekipman bulunmamaktadır.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('.delete-ekipman').click(function () {
                var id = $(this).data('id');
                var row = $(this).closest('tr');

                if (confirm('Bu kaydı silmek istediğinizden emin misiniz?')) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Ekipmanlar")',
                        type: 'POST',
                        data: { id: id },
                        success: function (result) {
                            if (result.success) {
                                row.fadeOut(300, function () {
                                    $(this).remove();
                                    if ($('tbody tr').length === 0) {
                                        $('tbody').append('<tr><td colspan="9" class="text-center">Henüz kayıtlı ekipman bulunmamaktadır.</td></tr>');
                                    }
                                });
                            } else {
                                toastr.error(result.message);
                            }
                        },
                        error: function () {
                            toastr.error('Silme işlemi sırasında bir hata oluştu.');
                        }
                    });
                }
            });
        });
    </script>
}
