@model List<TarimHibe.Models.ApiModels.IlceModel>
@{
    ViewBag.Title = "Ekipman Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ekipman = ViewBag.Ekipman as TarimHibe.Models.Ekipmanlar;
    var turList = ViewBag.EkipmanTurleri as List<SelectListItem>;
    var secilenMahalle = ekipman.Mahalle;
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-4">Ekipman Düzenle</h4>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

            
                    <form id="ekipmanForm" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EkipmanID" value="@ekipman.EkipmanID" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Ekipman Adı</label>
                                <input type="text" name="EkipmanAdi" value="@ekipman.EkipmanAdi" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Ekipman Türü</label>
                                <select name="TurID" class="form-select" required>
                                  <option value="">Tür Seçiniz</option>
                                  @{
                                    foreach (var item in turList)
                                    {
                                        var selected = item.Selected ? "selected=\"selected\"" : "";
                                        @:<option value="@item.Value" @Html.Raw(selected)>@item.Text</option>
                                    }
                                 }

                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Plaka</label>
                                <input type="text" name="Plaka" value="@ekipman.Plaka" class="form-control" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Marka</label>
                                <input type="text" name="Marka" value="@ekipman.Marka" class="form-control" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Model</label>
                                <input type="text" name="Modeli" value="@ekipman.Modeli" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">İlçe</label>
                                <select id="ilceSelect" name="Ilce" class="form-select" required>
                                    <option value="">İlçe Seçiniz</option>
                            
                                     @foreach (var ilce in Model)
                                        {
                                            var selectedAttr = ilce.Id.ToString() == ekipman.Ilce ? "selected=\"selected\"" : "";

                                            @:<option value="@ilce.Id" @Html.Raw(selectedAttr)>@ilce.IlceAdi</option>
                                        }

                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Mahalle</label>
                                <input type="hidden" id="secilenMahalle" value="@secilenMahalle" />
                                <select id="mahalleSelect" name="Mahalle" class="form-select" required>
                                    <option value="">Mahalle Seçiniz</option>
                             @if (ViewBag.Mahalleler != null)
                                {
                                    foreach (var mahalle in ViewBag.Mahalleler)
                                    {
                                        var selectedAttr = mahalle.MahalleKodu == secilenMahalle ? "selected=\"selected\"" : "";
                                        @:<option value="@mahalle.MahalleKodu" @Html.Raw(selectedAttr)>@mahalle.MahalleAdi</option>
                                    }
                                }

                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Adet</label>
                                <input type="number" name="Adet" value="@ekipman.Adet" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Durum</label>
                                <select name="Durum" class="form-select" required>
                                   
                                 @{
                                var aktifSelected = ekipman.Durum == "Aktif" ? "selected=\"selected\"" : "";
                                var pasifSelected = ekipman.Durum == "Pasif" ? "selected=\"selected\"" : "";
                                  }

                        <option value="Aktif" selected="@aktifSelected">Aktif</option>
                        <option value="Pasif" selected="@pasifSelected">Pasif</option>

                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="text-end">
                        <a href="@Url.Action("Index", "Ekipmanlar")" class="btn btn-secondary">İptal</a>
                        <button type="submit" class="btn btn-primary">Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
  <script>
        $(document).ready(function () {
            $('#ilceSelect').change(function () {
                var ilceId = $(this).val();
                var mahalleSelect = $('#mahalleSelect');

                mahalleSelect.prop('disabled', true).empty().append($('<option>', {
                    value: '',
                    text: 'Önce İlçe Seçiniz'
                }));

                if (!ilceId) return;
                    $.ajax({
                    url: '@Url.Action("GetMahalleler", "Ekipmanlar")',
                    type: 'GET',
                    data: { ilceId: ilceId },
                    dataType: 'json',
                    success: function (data) {
                        if (data.error) {
                            toastr.error(data.error);
                            return;
                        }
                        mahalleSelect.prop('disabled', false).empty().append($('<option>', {
                            value: '',
                            text: 'Mahalle Seçiniz'
                        }));

                        $.each(data, function (i, item) {
                            mahalleSelect.append($('<option>', {
                                value: item.mahalleKodu,
                                text: item.mahalleAdi
                            }));
                        });
                    },
                    error: function () {
                        toastr.error("Mahalleler alınırken bir hata oluştu.");
                    }
                });
            });
        });
    </script>
}
