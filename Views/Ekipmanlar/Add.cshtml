@model List<TarimHibe.Models.ApiModels.IlceModel>
@{
    ViewBag.Title = "Yeni Ekipman";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var turList = ViewBag.EkipmanTurleri as List<SelectListItem>;
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-4">Yeni Ekipman</h4>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }l

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                
                    <form id="ekipmanForm" asp-action="Add" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Ekipman Adı</label>
                                <input type="text" name="EkipmanAdi" id="EkipmanAdi" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Ekipman Türü</label>
                                <select name="TurID" class="form-select" required>
                                    <option value="">Tür Seçiniz</option>
                                    @if (turList != null)
                                    {
                                        foreach (var item in turList)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Plaka</label>
                                <input type="text" name="Plaka" class="form-control" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Marka</label>
                                <input type="text" name="Marka" class="form-control" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Model</label>
                                <input type="text" name="Modeli" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">İlçe</label>
                                <select id="ilceSelect" name="Ilce" class="form-select" required>
                                    <option value="">İlçe Seçiniz</option>
                                    @foreach (var ilce in Model)
                                    {
                                        <option value="@ilce.Id">@ilce.IlceAdi</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Mahalle</label>
                                <select id="mahalleSelect" name="Mahalle" class="form-select" required disabled>
                                    <option value="">Önce İlçe Seçiniz</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Adet</label>
                                <input type="number" class="form-control" id="Adet" name="Adet" required min="1" value="1">
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Durum</label>
                                <select name="Durum" class="form-select" required>
                                    <option value="Aktif">Aktif</option>
                                    <option value="Pasif">Pasif</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="text-end">
                        <a href="@Url.Action("Index", "Ekipmanlar")" class="btn btn-secondary">İptal</a>
                        <button type="submit" class="btn btn-success">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('#ilceSelect').change(function () {
                var ilceId = $(this).val();
                var mahalleSelect = $('#mahalleSelect');

                mahalleSelect.prop('disabled', true).empty().append($('<option>', {
                    value: '',
                    text: 'Önce İlçe Seçiniz'
                }));

                if (!ilceId) return;

                $.ajax({
                    url: '@Url.Action("GetMahalleler", "Ekipmanlar")',
                    type: 'GET',
                    data: { ilceId: ilceId },
                    dataType: 'json',
                    success: function (data) {

                       
                        if (data.error) {
                            toastr.error(data.error);
                            return;
                        }

                        mahalleSelect.prop('disabled', false).empty().append($('<option>', {
                            value: '',
                            text: 'Mahalle Seçiniz'
                        }));

                        $.each(data, function (i, item) {
                            mahalleSelect.append($('<option>', {
                                value: item.mahalleKodu,
                                text: item.mahalleAdi
                            }));
                        });
                    },
                    error: function () {
                        toastr.error("Mahalleler alınırken bir hata oluştu.");
                    }
                });
            });
        });
    </script>
}
