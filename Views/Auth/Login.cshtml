@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_BlankLayout.cshtml";
}

<style>
    /* Mobil için özel stiller */
    @@media (max-width: 767.98px) {
        .auth-logo {
            max-width: 150px !important;
            height: auto !important;
            margin-bottom: 1rem !important;
        }

        .auth-full-page-content {
            padding-top: 1rem !important;
            padding-bottom: 1rem !important;
        }

        .card {
            margin-top: 0 !important;
        }

        .bg-auth {
            display: none !important;
        }
    }
</style>

<div class="auth-maintenance d-flex align-items-center min-vh-100">
    <div class="bg-overlay bg-light"></div>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="auth-full-page-content d-flex min-vh-100 py-sm-5 py-4">
                    <div class="w-100">
                        <div class="d-flex flex-column h-100 py-0 py-xl-3">
                            <div class="text-center mb-4">
                                <a href="/" class="d-block">
                                    <img src="~/assets/images/logo_2x.png" alt="Logo" class="auth-logo logo-dark mx-auto" style="max-width: 200px; height: auto;">
                                    <img src="~/assets/images/logo_2x.png" alt="Logo" class="auth-logo logo-light mx-auto" style="max-width: 200px; height: auto;">
                                </a>
                            </div>

                            <div class="card my-auto overflow-hidden">
                                <div class="row g-0">
                                    <div class="col-lg-6 d-none d-lg-block">
                                        <div class="bg-overlay bg-primary"></div>
                                        <div class="h-100 bg-auth align-items-end">
                                        </div>
                                    </div>

                                    <div class="col-lg-6">
                                        <div class="p-lg-5 p-4">
                                            <div>
                                                <div class="text-center mt-1">
                                                    <h4 class="font-size-18">Hoş Geldiniz!</h4>
                                                    <p class="text-muted">Giriş yaparak devam edin.</p>
                                                </div>

                                                @if (TempData["ErrorMessage"] != null)
                                                {
                                                    <div class="alert alert-danger">
                                                        @TempData["ErrorMessage"]
                                                    </div>
                                                }

                                                <form asp-action="Login" method="post" class="auth-input">
                                                    @Html.AntiForgeryToken()
                                                    <div class="mb-2">
                                                        <label for="TcKimlikNo" class="form-label">TC Kimlik No</label>
                                                        <input type="text" class="form-control" id="TcKimlikNo" name="TcKimlikNo"
                                                               placeholder="TC Kimlik No" required maxlength="11" pattern="[0-9]{11}">
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label" for="Parola">Şifre</label>
                                                        <input type="password" class="form-control" id="Parola" name="Parola"
                                                               placeholder="Şifrenizi girin" required>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" value="" id="auth-remember-check">
                                                        <label class="form-check-label" for="auth-remember-check">Beni Hatırla</label>
                                                    </div>
                                                    <div class="mt-3">
                                                        <button class="btn btn-primary w-100" type="submit">Giriş Yap</button>
                                                    </div>
                                                </form>

                                            </div>

                                            <div class="mt-4 text-center">
                                                <p class="mb-0">Hesabınız yok mu? <a href="@Url.Action("Register", "Auth")" class="fw-medium text-primary">Kayıt Ol</a></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-5 text-center">
                                <p class="mb-0">
                                    © @DateTime.Now.Year <i class=""></i> Tarımsal Hizmetler Dairesi Başkanlığı
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/assets/js/app.js"></script>
}