@model List<TarimHibe.Models.Arazi>
@{
    ViewBag.Title = "Arazilerim";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="card-title mb-0">Arazilerim</h4>
                        <p class="card-title-desc">Kayıtlı arazilerinizin listesi</p>
                    </div>
                    <a href="@Url.Action("Add", "Arazi")" class="btn btn-primary">
                        <i class="ri-add-line align-middle me-1"></i> Yeni Arazi Ekle
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sertifika Tarihi</th>
                                <th>Hisse Türü</th>
                                <th>Arazi Türü</th>
                                <th>Sulama</th>
                                <th>İlçe / Mahalle</th>
                                <th>Ada</th>
                                <th>Parsel</th>
                                <th>Mevkii</th>
                                <th>Hisse Alanı</th>
                                <th>Durumu</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    var cks = item.CKSBelgeleri?.FirstOrDefault();
                                    <tr>
                                        <td>@cks?.Yil</td>
                                        <td>@item.MulkiyetBilgisi?.MulkiyetAdi</td>
                                        <td>@item.AraziTuruBilgisi?.AraziTurAdi</td>
                                        <td>@item.SulamaBilgisi?.AraziSulamaAdi</td>
                                        <td>@item.IlceAdi / @item.MahalleAdi</td>
                                        <td>@item.Ada</td>
                                        <td>@item.Parsel</td>
                                        <td>@item.Mevkii</td>
                                        <td>@item.HisseAlani da</td>
                                        <td>
                                            @if (cks != null)
                                            {
                                                <span class="badge
                                                @(cks.OnayDurumu == 1 ? "bg-success" :
                                                  cks.OnayDurumu == 2 ? "bg-danger" :
                                                  "bg-warning")">
                                                 @(cks.OnayDurumu == 1 ? "Onaylandı" :
                                                   cks.OnayDurumu == 2 ? "Onaylanmadı" :
                                                   "Onay Sürecinde")
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a href="@Url.Action("Edit", "Arazi", new { id = item.Id })" class="btn btn-primary btn-sm">
                                                    <i class="ri-pencil-line"></i>
                                                </a>
                                                <button type="button" class="btn btn-danger btn-sm delete-arazi" data-id="@item.Id">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="11" class="text-center">Henüz kayıtlı arazi bulunmamaktadır.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script>
        $(document).ready(function () {
            $('.delete-arazi').click(function () {
                var id = $(this).data('id');
                var row = $(this).closest('tr');

                if (confirm('Bu arazi kaydını silmek istiyor musunuz?')) {
                    $.post('@Url.Action("Delete", "Arazi")', { id: id }, function (result) {
                        if (result.success) {
                            row.fadeOut(300, function () {
                                $(this).remove();
                            });
                        } else {
                            alert(result.message || 'Silme işlemi sırasında hata oluştu.');
                        }
                    });
                }
            });
        });
    </script>
}
