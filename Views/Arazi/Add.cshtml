            // Drag and drop handling
            $('.file-upload-area').on({
                dragover: function(e) {
                    e.preventDefault();
                    $(this).addClass('bg-light');
                },
                dragleave: function(e) {
                    e.preventDefault();
                    $(this).removeClass('bg-light');
                },
                drop: function(e) {
                    e.preventDefault();
                    $(this).removeClass('bg-light');

                    var file = e.originalEvent.dataTransfer.files[0];
                    $('#CksBelgesi')[0].files = e.originalEvent.dataTransfer.files;

                    if (file) {
                        $('#selected-file').removeClass('d-none')
                            .find('.badge').text(file.name);
                    }
                }
            });
        });
