@model List<TarimHibe.Models.HibeCardViewModel>
@{
    ViewBag.Title = "Hibeler";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="row g-4">
                    @foreach (var h in Model.Where(h => h.Yayinda))
                    {
                        <div class="col-md-3">
                            <div class="card h-100 rounded-3 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@h.HibeTuru</h5>
                                    <p class="card-text mb-1"><strong>Miktar:</strong> @h.Miktar</p>
                                    <p class="card-text mb-3">
                                        <span class="badge @(h.UcretliMi ? "bg-danger" : "bg-success")">
                                            @(h.UcretliMi ? "Ücretli" : "Ücretsiz")
                                        </span>
                                    </p>
                                    <div class="mt-auto">
                                        @* Önce: Arazi var mı? *@
                                        @if (!h.HasRegisteredArazi)
                                        {
                                            <button class="btn btn-warning btn-sm w-100" disabled>
                                                Lütfen önce arazi bilgilerinizi girin
                                            </button>
                                        }
                                        @* Sonra: Onaylı CKS belgesi var mı? *@
                                        else if (!h.HasApprovedCks)
                                        {
                                            <button class="btn btn-warning btn-sm w-100" disabled>
                                                Onaylı CKS belgesi yüklenmeli
                                            </button>
                                        }
                                        @* Daha önce başvuru yapıldıysa *@
                                        else if (h.AlreadyApplied)
                                        {
                                            <button class="btn btn-secondary btn-sm w-100" disabled>
                                                Başvuru Yapıldı
                                            </button>
                                        }
                                        else
                                        {
                                            <a asp-action="Apply"
                                               asp-route-id="@h.HibeID"
                                               class="btn btn-primary btn-sm w-100">
                                                Başvur
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                </div>

                </div>
                </div>
                </div>



