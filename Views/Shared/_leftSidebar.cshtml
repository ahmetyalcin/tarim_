<!-- ========== Left Sidebar Start ========== -->
<link href="~/assets/css/menu.css" rel="stylesheet" />
<script src="~/assets/js/menu.js"></script>

@using TarimHibe.Services
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject INotificationService NotificationService

@{
    var userId = int.Parse(HttpContextAccessor.HttpContext.Session.GetString("UserId") ?? "0");
    var adSoyad = HttpContextAccessor.HttpContext.Session.GetString("AdSoyad") ?? "Misafir";
    var initial = string.IsNullOrEmpty(adSoyad) ? "" : adSoyad.Substring(0, 1).ToUpper();
    var unreadCount = NotificationService
                          .GetUserNotificationsAsync(userId)
                          .GetAwaiter().GetResult()
                          .Count(n => !n.IsRead);
}

<div class="vertical-menu">
    <div data-simplebar class="vertical-scroll">
        <!--- Sidemenu -->
        <div id="sidebar-menu">

            <div class="dropdown mx-3 sidebar-user user-dropdown select-dropdown">
                <!-- 🔔 Bell + badge -->
                <div class="text-end px-3 mb-2 position-relative">
                    <a href='@Url.Action("Index","Notifications")' class="text-decoration-none text-dark">
                        <i class="mdi mdi-bell font-size-20"></i>
                        @if (unreadCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill position-absolute top-0 start-100 translate-middle">
                                @unreadCount
                            </span>
                        }
                    </a>
                </div>

                <!-- Kullanıcı dropdown toggle -->
                <button type="button"
                        class="btn btn-light w-100 waves-effect waves-light border-0"
                        id="page-header-user-dropdown"
                        data-bs-toggle="dropdown"
                        aria-haspopup="true"
                        aria-expanded="false">
                    <span class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="avatar-xs rounded-circle flex-shrink-0">
                                <div class="avatar-title border bg-light text-primary rounded-circle text-uppercase user-sort-name">
                                    @initial
                                </div>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-2 text-start">
                            <h6 class="mb-1 fw-medium user-name-text">@adSoyad</h6>
                            <p class="font-size-13 text-muted user-name-sub-text mb-0">@adSoyad</p>
                        </div>
                        <div class="flex-shrink-0 text-end">
                            <i class="mdi mdi-chevron-down font-size-16"></i>
                        </div>
                    </span>
                </button>

                <!-- Dropdown menüsü -->
                <div class="dropdown-menu dropdown-menu-end w-100">
                    <a class="dropdown-item d-flex align-items-center px-3"
                       asp-controller="Profile" asp-action="Index">
                        <div class="flex-shrink-0 me-2">
                            <div class="avatar-xs rounded-circle">
                                <div class="avatar-title border rounded-circle dropdown-sort-name">P</div>
                            </div>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-0 dropdown-name">Profilim</h6>
                        </div>
                    </a>

                    <a class="dropdown-item d-flex align-items-center px-3"
                       asp-controller="Notifications" asp-action="Index">
                        <div class="flex-shrink-0 me-2">
                            <div class="avatar-xs rounded-circle">
                                <div class="avatar-title border rounded-circle dropdown-sort-name">B</div>
                            </div>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-0 dropdown-name">Bildirimler (@unreadCount)</h6>
                        </div>
                    </a>

                    <a class="dropdown-item d-flex align-items-center px-3"
                       asp-controller="Auth" asp-action="Logout">
                        <div class="flex-shrink-0 me-2">
                            <div class="avatar-xs rounded-circle">
                                <div class="avatar-title border rounded-circle dropdown-sort-name">Ç</div>
                            </div>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-0 dropdown-name">Çıkış</h6>
                        </div>
                    </a>
                </div>
            </div>

            @using TarimHibe.Models
            @{
                var menu = ViewBag.SidebarMenu as IEnumerable<MenuItem>
                ?? Enumerable.Empty<MenuItem>();
            }
            <ul id="side-menu" class="metismenu list-unstyled">
                @await Html.PartialAsync("_Menu", menu)
            </ul>

        </div>
        <!-- Sidebar -->
    </div>
</div>
<!-- Left Sidebar End -->
